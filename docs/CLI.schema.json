{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FueTsui/SightOCR/main/docs/CLI.schema.json",
  "title": "SightOCR CLI --json output",
  "description": "One JSON object is emitted for each sightocr-cli invocation with --json. Errors use the error variant.",
  "oneOf": [
    {
      "type": "object",
      "required": ["operation", "provider", "table", "text"],
      "properties": {
        "operation": { "const": "ocr" },
        "provider": { "const": "local" },
        "table": { "type": "boolean" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["operation", "provider", "source_lang", "target_lang", "text"],
      "properties": {
        "operation": { "const": "translate" },
        "provider": { "type": "string" },
        "source_lang": { "type": "string" },
        "target_lang": { "type": "string" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["languages"],
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "name", "source", "target"],
            "properties": {
              "code": { "type": "string" },
              "name": { "type": "string" },
              "source": { "type": "boolean" },
              "target": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["providers", "source_lang", "target_lang"],
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider", "name", "configured", "default"],
            "properties": {
              "provider": { "type": "string" },
              "name": { "type": "string" },
              "configured": { "type": "boolean" },
              "default": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "source_lang": { "type": "string" },
        "target_lang": { "type": "string" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": { "type": "string" }
      },
      "additionalProperties": false
    }
  ]
}
